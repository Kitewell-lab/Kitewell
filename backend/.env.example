# Kitewell backend environment variables
# Copy this file to .env and adjust as needed.

# Port the Express server listens on
PORT=8787

# Stellar Horizon server URL
HORIZON_URL=https://horizon-testnet.stellar.org

# Network passphrase label (used in /health and /api/network responses)
NETWORK=TESTNET

# Stellar Friendbot URL for funding Testnet accounts
FRIENDBOT_URL=https://friendbot.stellar.org

# Base URL for building Stellar Expert explorer links
EXPLORER_BASE=https://stellar.expert/explorer/testnet

# Soroban contract ID — set after deploying contracts/kitewell on Testnet
# Leave blank or unset to disable contract features
KITEWELL_CONTRACT_ID=
