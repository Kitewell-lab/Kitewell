# Kitewell backend environment variables
# Copy this file to .env and adjust as needed.

# Port the Express server listens on
PORT=8787

# Stellar network the backend serves: TESTNET or FUTURENET.
# Selects the network passphrase and the default URLs below.
# An unrecognised value stops the server at startup instead of silently
# falling back to Testnet.
NETWORK=TESTNET

# The four URLs below default to the selected NETWORK:
#   TESTNET   — https://horizon-testnet.stellar.org, https://friendbot.stellar.org,
#               https://stellar.expert/explorer/testnet, https://soroban-testnet.stellar.org
#   FUTURENET — https://horizon-futurenet.stellar.org, no Friendbot (null),
#               https://stellar.expert/explorer/futurenet, https://rpc-futurenet.stellar.org
# Uncomment any of them to override that network's default.

# Stellar Horizon server URL
#HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar Friendbot URL for funding accounts.
# Futurenet has no Friendbot, so it stays null there unless set explicitly.
#FRIENDBOT_URL=https://friendbot.stellar.org

# Base URL for building Stellar Expert explorer links
#EXPLORER_BASE=https://stellar.expert/explorer/testnet

# Soroban RPC URL used by the backend
#SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional request rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Soroban contract ID — set after deploying contracts/kitewell on Testnet
# Leave blank or unset to disable contract features
KITEWELL_CONTRACT_ID=
